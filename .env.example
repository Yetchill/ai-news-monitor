# Copy to .env for local overrides. Never commit .env.
AIM_ENVIRONMENT=development
AIM_DATABASE_URL=sqlite:///data/intelligence.db
AIM_LOG_DIR=logs
AIM_LOG_LEVEL=INFO
AIM_LOG_MAX_BYTES=10485760
AIM_LOG_BACKUP_COUNT=5

# Rule mode is local and does not call an AI provider.
AIM_CLASSIFIER_MODE=rule

# Optional OpenAI-compatible provider settings. Leave the key empty by default.
AIM_LLM_BASE_URL=https://api.deepseek.com
AIM_LLM_API_KEY=
AIM_LLM_MODEL=deepseek-chat
AIM_LLM_TIMEOUT_SECONDS=30
AIM_LLM_CONFIDENCE_THRESHOLD=0.7
